ARG BROWSER_RUNTIME_IMAGE=debian:bookworm-slim
FROM golang:1.26-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY internal ./internal
COPY cmd ./cmd
ARG BUILD_VERSION
ARG BUILD_COMMIT=unknown
ARG BUILD_DIRTY=false
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-X aa-server/internal/buildinfo.Version=${BUILD_VERSION} -X aa-server/internal/buildinfo.Commit=${BUILD_COMMIT} -X aa-server/internal/buildinfo.Dirty=${BUILD_DIRTY}" -o /out/aa-server ./cmd/aa-server && \
    CGO_ENABLED=0 go build -trimpath -ldflags "-X aa-server/internal/buildinfo.Version=${BUILD_VERSION} -X aa-server/internal/buildinfo.Commit=${BUILD_COMMIT} -X aa-server/internal/buildinfo.Dirty=${BUILD_DIRTY}" -o /out/aa-id ./cmd/aa-id && \
    CGO_ENABLED=0 go build -trimpath -o /out/aa-import ./cmd/aa-import && \
    CGO_ENABLED=0 go build -trimpath -o /out/aa-init ./cmd/aa-init && \
    CGO_ENABLED=0 go build -trimpath -o /out/aa-health ./cmd/aa-health && \
    CGO_ENABLED=0 go build -trimpath -o /out/playwright github.com/mxschmitt/playwright-go/cmd/playwright

FROM ${BROWSER_RUNTIME_IMAGE}
USER root
ENV PLAYWRIGHT_DRIVER_PATH=/opt/playwright-driver PLAYWRIGHT_BROWSERS_PATH=/ms-playwright HOME=/tmp XDG_CACHE_HOME=/tmp/cache
WORKDIR /srv
COPY --from=build /out/playwright /usr/local/bin/playwright
RUN if [ ! -f /opt/playwright-driver/package/package.json ]; then \
      apt-get update && apt-get install -y --no-install-recommends ca-certificates && \
      playwright install --with-deps --only-shell chromium && rm -rf /var/lib/apt/lists/*; \
    fi && find /opt/playwright-driver /ms-playwright ! -perm -004 -exec chmod a+r '{}' + && \
    find /opt/playwright-driver /ms-playwright -type d ! -perm -001 -exec chmod a+rx '{}' + && \
    find /opt/playwright-driver /ms-playwright -type f -perm /111 ! -perm -001 -exec chmod a+rx '{}' + && \
    if ! id -u sessionserver >/dev/null 2>&1; then useradd --uid 10001 --create-home sessionserver; fi && \
    mkdir -p /data && chown 10001:10001 /data
COPY --from=build /out/ /usr/local/bin/
COPY static ./static
COPY services/aa-id/aaid/static ./aaid-static
USER 10001:10001
EXPOSE 8080 8090
CMD ["aa-server", "-listen", "0.0.0.0:8080"]
